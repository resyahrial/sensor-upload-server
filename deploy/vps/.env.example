# Environment for deploy/vps/docker-compose.yml. Do not edit this file for a
# deployment: `make vps-secrets VPS_IP=...` (gen-secrets.sh) writes the real
# one to deploy/vps/secrets/.env with random credentials, and `make vps-deploy`
# copies it to /srv/sensor-upload/.env (mode 600) on the VPS.
#
# Values must not contain spaces, quotes, '$', '@', ':' or '/' (they are used
# inside DATABASE_URL); gen-secrets.sh uses hex.

# --- secrets (generated) ---
POSTGRES_PASSWORD=change-me-postgres-password-hex
MINIO_ROOT_USER=sensoradmin
MINIO_ROOT_PASSWORD=change-me-minio-root-password-hex
# Bucket-scoped MinIO user the server runs as (created by minio-init).
S3_ACCESS_KEY=upload-server
S3_SECRET_KEY=change-me-minio-server-secret-hex

# --- storage ---
S3_BUCKET=uploads

# --- server tuning (defaults shown) ---
LOG_LEVEL=info
MAX_FILE_BYTES=524288000
INCOMPLETE_TTL=168h
CLEANUP_INTERVAL=1h
RETENTION_MAX_AGE=168h
DISK_HIGH_WATERMARK=85
DISK_LOW_WATERMARK=70
DISK_CHECK_INTERVAL=1m
GOMEMLIMIT=800MiB

# --- host side (defaults shown; change only to run the stack elsewhere) ---
# DATA_DIR=/srv/sensor-upload
# SERVER_IMAGE=localhost/sensor-upload-server:vps
# HTTPS_BIND=0.0.0.0
# HTTPS_PORT=443
# GRPC_BIND=0.0.0.0
# GRPC_PORT=9090
# METRICS_BIND=127.0.0.1
# METRICS_PORT=9100
# MINIO_CONSOLE_BIND=127.0.0.1
# MINIO_CONSOLE_PORT=9001
